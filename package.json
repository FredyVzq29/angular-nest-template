{
    "name": "@my-angular-nest-app/source",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "serve:server": "npx nx serve server",
        "serve:web": "npx nx serve web",
        "serve:mobile": "npx nx serve mobile",
        "serve:all": "npx nx run-many -t serve -p server,web,mobile --parallel=3",
        "build:server": "npx nx build server",
        "build:web": "npx nx build web",
        "build:mobile": "npx nx build mobile",
        "build:all": "npx nx run-many -t build -p server,web,mobile",
        "lint:server": "npx nx lint server",
        "lint:web": "npx nx lint web",
        "lint:mobile": "npx nx lint mobile",
        "lint:all": "npx nx run-many -t lint",
        "test:all": "npx nx run-many -t test",
        "affected": "npx nx affected -t lint,test,build",
        "format": "npx nx format:write",
        "format:all": "npx prettier --write .",
        "graph": "npx nx graph",
        "find-circular": "madge --circular --extensions ts --ts-config ./tsconfig.base.json ./apps $( [ -d ./libs ] && echo ./libs )",
        "mobile:add:android": "npx nx run mobile:add:android",
        "mobile:add:ios": "npx nx run mobile:add:ios",
        "mobile:sync:android": "npx nx build mobile && npx nx run mobile:sync:android",
        "mobile:sync:ios": "npx nx build mobile && npx nx run mobile:sync:ios",
        "mobile:open:android": "npx nx run mobile:open:android",
        "mobile:open:ios": "npx nx run mobile:open:ios",
        "build:mobile:android": "npx nx build mobile && npx nx run mobile:run:android",
        "build:mobile:ios": "npx nx build mobile && npx nx run mobile:run:ios",
        "prepare": "husky",
        "release": "standard-version",
        "release:patch": "standard-version --release-as patch",
        "release:minor": "standard-version --release-as minor",
        "release:major": "standard-version --release-as major",
        "release:beta": "standard-version --prerelease beta",
        "release:alpha": "standard-version --prerelease alpha"
    },
    "private": true,
    "dependencies": {
        "@angular/common": "~22.1.0",
        "@angular/compiler": "~22.1.0",
        "@angular/core": "~22.1.0",
        "@angular/forms": "~22.1.0",
        "@angular/platform-browser": "~22.1.0",
        "@angular/platform-browser-dynamic": "~22.1.0",
        "@angular/router": "~22.1.0",
        "@capacitor/android": "^8.0.0",
        "@capacitor/app": "^8.0.0",
        "@capacitor/core": "^8.0.0",
        "@capacitor/haptics": "^8.0.0",
        "@capacitor/ios": "^8.0.0",
        "@capacitor/keyboard": "^8.0.0",
        "@capacitor/status-bar": "^8.0.0",
        "@ionic/angular": "^8.0.0",
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "axios": "^1.6.0",
        "ionicons": "^8.0.0",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.0"
    },
    "devDependencies": {
        "@angular-devkit/core": "~22.1.0",
        "@angular-devkit/schematics": "~22.1.0",
        "@angular/build": "~22.1.0",
        "@angular/cli": "~22.1.0",
        "@angular/compiler-cli": "~22.1.0",
        "@angular/language-service": "~22.1.0",
        "@capacitor/cli": "^8.0.0",
        "@eslint/js": "^9.8.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.0",
        "@nx/angular": "^23.2.0",
        "@nx/eslint": "23.2.0",
        "@nx/eslint-plugin": "23.2.0",
        "@nx/jest": "23.2.0",
        "@nx/js": "23.2.0",
        "@nx/nest": "23.2.0",
        "@nx/node": "23.2.0",
        "@nx/web": "23.2.0",
        "@nx/webpack": "23.2.0",
        "@nx/workspace": "23.2.0",
        "@nxext/capacitor": "^23.0.0",
        "@nxext/ionic-angular": "^23.0.0",
        "@schematics/angular": "~22.1.0",
        "@swc/helpers": "~0.5.18",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/jest": "~30.0.0",
        "@types/node": "^22.0.0",
        "@typescript-eslint/utils": "^8.58.0",
        "angular-eslint": "^22.1.0",
        "eslint": "^9.8.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "jest": "~30.3.0",
        "jest-environment-jsdom": "~30.3.0",
        "jest-environment-node": "~30.3.0",
        "jest-preset-angular": "~17.0.0",
        "jest-util": "~30.3.0",
        "nx": "23.2.0",
        "prettier": "~3.6.2",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "ts-jest": "^29.4.7",
        "ts-node": "10.9.1",
        "tslib": "^2.3.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.58.0",
        "webpack": "^5.101.3",
        "webpack-cli": "^7.0.0",
        "webpack-dev-server": "^5.2.1"
    }
}
