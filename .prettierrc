{
    "printWidth": 200,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "bracketSpacing": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "overrides": [
        {
            "files": ["*.html"],
            "options": {
                "parser": "html"
            }
        },
        {
            "files": ["*.yml"],
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": ["**/*.scss"],
            "options": {
                "singleQuote": true
            }
        }
    ],
    "plugins": ["prettier-plugin-tailwindcss"]
}
